# HTTPS-Zertifikat holt Caddy automatisch (Let's Encrypt), sobald DOMAIN per DNS
# auf diesen Server zeigt.
#
# WICHTIG: Diese Datei ist die einzige Caddy-Konfiguration des Servers und wird bei jedem
# Deploy aus dem Repo überschrieben (git reset --hard). Blöcke anderer Apps auf demselben
# Server gehören deshalb HIER ins Repo – von Hand angehängte Blöcke gehen verloren.
# Jeder Name darf nur einmal vorkommen, sonst startet Caddy nicht.
{$DOMAIN} {
	encode zstd gzip

	# Sync-Dienst unter /powersync (Präfix wird entfernt). flush_interval -1:
	# Der Sync-Stream muss sofort weitergereicht werden, nicht gepuffert.
	handle_path /powersync/* {
		reverse_proxy haushalt-powersync:8080 {
			flush_interval -1
		}
	}

	# Alles andere: API und Frontend
	handle {
		reverse_proxy haushalt-app:3000
	}
}

# Einträge anderer Apps aus dem gemeinsamen Volume caddy-sites (Stammtisch-ADR 0024).
# Jede App legt beim eigenen Deploy ihre Datei <app>.caddy hinein, lässt diesen Caddy
# die ganze Konfiguration prüfen (caddy validate) und lädt ihn ohne Neustart neu
# (caddy reload). Erreichbar sind die Apps über das gemeinsame Netzwerk edge. Neue
# Apps brauchen deshalb keine Änderung mehr in diesem Repo. Heute: stammtisch.caddy
# (j4nric/skat-roguelite), vszw.caddy (j4nric/tree-grow-app, sync.…), tee.caddy
# (j4nric/sticker-plot), uhrturm.caddy (j4nric/auto-battle), beinggod.caddy
# (j4nric/ecosystem-loop), jeweils aus deren Repo. Jeder Name darf auf dem Server nur
# einmal vorkommen – auch nicht hier und in einer Datei zugleich.
import /etc/caddy/sites/*.caddy
