# Vorlage für den Server. Kopieren: cp .env.example .env – dann alle Werte setzen.

# Domain, unter der die App erreichbar ist (DNS-A-Record muss auf den Server zeigen)
DOMAIN=haushalt.example.de

# Image aus der GitHub Container Registry (wird vom Deployment gesetzt)
APP_IMAGE=ghcr.io/j4nric/haushalt-app:latest

POSTGRES_USER=haushalt
POSTGRES_DB=haushalt
# Erzeugen mit: openssl rand -hex 24
POSTGRES_PASSWORD=

# Erzeugen mit: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Erzeugen mit: openssl rand -hex 24
POWERSYNC_ADMIN_TOKEN=
