# HTTPS-Zertifikat holt Caddy automatisch (Let's Encrypt), sobald DOMAIN per DNS
# auf diesen Server zeigt.
{$DOMAIN} {
	encode zstd gzip

	# Sync-Dienst unter /powersync (Präfix wird entfernt). flush_interval -1:
	# Der Sync-Stream muss sofort weitergereicht werden, nicht gepuffert.
	handle_path /powersync/* {
		reverse_proxy haushalt-powersync:8080 {
			flush_interval -1
		}
	}

	# Alles andere: API und Frontend
	handle {
		reverse_proxy haushalt-app:3000
	}
}

# Sync-Server des Spiels „Vom Samen zum Wald“ (Repo j4nric/tree-grow-app, Container
# vszw-sync im eigenen Netzwerk vszw-proxy). Eigene Subdomain – die Haushalt-App selbst
# läuft unter {$DOMAIN} = 62-83-23-90.sslip.io, ein zweiter Block dafür ließe Caddy nicht
# starten. sslip.io löst auch Subdomains auf die Server-IP auf; Caddy holt das Zertifikat.
# flush_interval -1: Live-Sync (Server-Sent Events) sofort weiterreichen.
sync.62-83-23-90.sslip.io {
	reverse_proxy vszw-sync:8787 {
		flush_interval -1
	}
}
