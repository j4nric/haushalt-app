{
  "name": "@haushalt/api",
  "version": "0.0.0",
  "private": true,
  "description": "Hono API (Backend)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/index.mjs --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@haushalt/db": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/web-push": "3.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
