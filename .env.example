# Vorlage für die lokale Umgebung. Kopieren mit: cp .env.example .env
# Die echte .env wird nie committet.

# PostgreSQL
POSTGRES_USER=haushalt
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=haushalt
POSTGRES_PORT=5432

# PowerSync
POWERSYNC_PORT=8080
# Schlüssel zum Signieren der Client-Tokens (base64url).
# Erzeugen mit: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
POWERSYNC_JWT_SECRET=
# Token für die Admin-API von PowerSync. Erzeugen mit: openssl rand -hex 24
POWERSYNC_ADMIN_TOKEN=

# API
API_PORT=3000
